generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")  
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  fullName         String
  phone            String?
  role             Role      @default(PATIENT)
  provider         String    @default("email")
  emailVerified    Boolean   @default(false)
  createdAt        DateTime  @default(now())
  verificationCode      String?
  verificationExpiresAt DateTime?
  resetToken            String?
  resetTokenExpiresAt   DateTime?

  bookings         Booking[]
  doctor           Doctor?
  healthProfile    HealthProfile?
  healthInsights   HealthInsight[]
  reminders        Reminder[]
  wallet           Wallet?
  paymentMethods   PaymentMethod[]
  chatSessions     ChatSession[]
  refreshTokens    RefreshToken[]
  emailTokens      EmailToken[]
  payments         Payment[]
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
  CENTER_ADMIN
}

model Center {
  id          String   @id @default(uuid())
  name        String
  address     String
  city        String
  phone       String?
  email       String?
  specialties String[]
  createdAt   DateTime @default(now())

  doctors     Doctor[]
}

model Doctor {
  id              String   @id @default(uuid())
  userId          String   @unique
  centerId        String
  specialties     String[]
  bio             String?
  rating          Float    @default(0)
  pricePerSession Float
  languages       String[]
  isAvailable     Boolean  @default(true)

  user            User     @relation(fields: [userId], references: [id])
  center          Center   @relation(fields: [centerId], references: [id])
  slots           Slot[]
  bookings        Booking[]
}

model Slot {
  id        String   @id @default(uuid())
  doctorId  String
  date      DateTime
  startTime String
  endTime   String
  isBooked  Boolean  @default(false)

  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  booking   Booking?
}

model Booking {
  id          String        @id @default(uuid())
  patientId   String
  doctorId    String
  slotId      String        @unique
  status      BookingStatus @default(PENDING)
  sessionType SessionType   @default(CLINIC)
  notes       String?
  createdAt   DateTime      @default(now())
  bookedVia   BookedVia     @default(APP)

  patient     User          @relation(fields: [patientId], references: [id])
  doctor      Doctor        @relation(fields: [doctorId], references: [id])
  slot        Slot          @relation(fields: [slotId], references: [id])
  totalAmount Float?
  paidAt      DateTime?
  payment     Payment?
  }

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum SessionType {
  CLINIC
  HOME_VISIT
}

enum BookedVia {
  APP
  AI_AGENT
  MANUAL
}

model HealthProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  age            String?
  gender         String?
  backPain       Boolean  @default(false)
  jointPain      Boolean  @default(false)
  sportsInjury   Boolean  @default(false)
  neckIssues     Boolean  @default(false)
  activityLevel  String?  // 'Low', 'Moderate', 'High'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id])
}

model HealthInsight {
  id        String   @id @default(uuid())
  userId    String
  heartRate Int?
  dailySteps Int?
  exerciseSessions Int @default(0)
  totalSessions    Int @default(0)
  painLevel Float?
  sleepQuality Float?
  week      DateTime @default(now())
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model Reminder {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      ReminderType @default(SESSION)
  time      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

enum ReminderType {
  SESSION
  EXERCISE
  MEDICATION
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Float    @default(0)
  currency  String   @default("QAR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
  rewards      Reward?
}

model Transaction {
  id          String            @id @default(uuid())
  walletId    String
  type        TransactionType
  category    TransactionCategory
  title       String
  subtitle    String
  amount      Float             // positive = credit, negative = debit
  status      TransactionStatus @default(COMPLETED)
  createdAt   DateTime          @default(now())

  wallet      Wallet            @relation(fields: [walletId], references: [id])
}

model Reward {
  id        String   @id @default(uuid())
  walletId  String   @unique
  points    Int      @default(0)
  updatedAt DateTime @updatedAt

  wallet    Wallet   @relation(fields: [walletId], references: [id])
}

model PaymentMethod {
  id         String            @id @default(uuid())
  userId     String
  type       PaymentMethodType
  label      String
  sublabel   String
  last4      String?
  expiry     String?
  holderName String?
  isDefault  Boolean           @default(false)
  isVerified Boolean           @default(true)
  provider   String?           // 'visa', 'mastercard', 'qnb', 'apple', etc.
  createdAt  DateTime          @default(now())

  user       User              @relation(fields: [userId], references: [id])
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionCategory {
  SESSION
  TOP_UP
  HOME_VISIT
  REFERRAL
  REHABILITATION
  WITHDRAWAL
  OTHER
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
}

enum PaymentMethodType {
  CARD
  BANK
  DIGITAL_WALLET
}

model ChatSession {
  id        String    @id @default(uuid())
  userId    String
  title     String    @default("New Chat")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())

  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

enum MessageRole {
  USER
  ASSISTANT
}

model PromoCode {
  id              String   @id @default(uuid())
  code            String   @unique
  discountPercent Float
  isActive        Boolean  @default(true)
  expiresAt       DateTime?
  usageLimit      Int?
  usageCount      Int      @default(0)
  createdAt       DateTime @default(now())
}

// ── Refresh tokens ────────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique                        // store hash, not raw token
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Email verification & password reset tokens ────────────────────
model EmailToken {
  id        String         @id @default(uuid())
  userId    String
  token     String         @unique
  type      EmailTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum EmailTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String        @unique
  patientId       String
  amount          Float
  currency        String        @default("QAR")
  status          PaymentStatus @default(PENDING)
  provider        String        @default("tap")
  providerChargeId String?      // Tap's charge ID
  providerRefundId String?      // Tap's refund ID if refunded
  paymentMethod   String?       // "card", "apple_pay", etc.
  metadata        Json?         // raw provider response
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  redirectUrl     String?

  booking         Booking       @relation(fields: [bookingId], references: [id])
  patient         User          @relation(fields: [patientId], references: [id])
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}