generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")  
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role     @default(PATIENT)
  provider     String   @default("email")
  createdAt    DateTime @default(now())

  bookings     Booking[]
  doctor       Doctor?
  healthProfile HealthProfile?
  healthInsights HealthInsight[]
  reminders      Reminder[]
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
  CENTER_ADMIN
}

model Center {
  id          String   @id @default(uuid())
  name        String
  address     String
  city        String
  phone       String?
  email       String?
  specialties String[]
  createdAt   DateTime @default(now())

  doctors     Doctor[]
}

model Doctor {
  id              String   @id @default(uuid())
  userId          String   @unique
  centerId        String
  specialties     String[]
  bio             String?
  rating          Float    @default(0)
  pricePerSession Float
  languages       String[]
  isAvailable     Boolean  @default(true)

  user            User     @relation(fields: [userId], references: [id])
  center          Center   @relation(fields: [centerId], references: [id])
  slots           Slot[]
  bookings        Booking[]
}

model Slot {
  id        String   @id @default(uuid())
  doctorId  String
  date      DateTime
  startTime String
  endTime   String
  isBooked  Boolean  @default(false)

  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  booking   Booking?
}

model Booking {
  id          String        @id @default(uuid())
  patientId   String
  doctorId    String
  slotId      String        @unique
  status      BookingStatus @default(PENDING)
  sessionType SessionType   @default(CLINIC)
  notes       String?
  createdAt   DateTime      @default(now())
  bookedVia   BookedVia     @default(APP)

  patient     User          @relation(fields: [patientId], references: [id])
  doctor      Doctor        @relation(fields: [doctorId], references: [id])
  slot        Slot          @relation(fields: [slotId], references: [id])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum SessionType {
  CLINIC
  HOME_VISIT
}

enum BookedVia {
  APP
  AI_AGENT
  MANUAL
}

model HealthProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  age            String?
  gender         String?
  backPain       Boolean  @default(false)
  jointPain      Boolean  @default(false)
  sportsInjury   Boolean  @default(false)
  neckIssues     Boolean  @default(false)
  activityLevel  String?  // 'Low', 'Moderate', 'High'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id])
}

model HealthInsight {
  id        String   @id @default(uuid())
  userId    String
  heartRate Int?
  dailySteps Int?
  exerciseSessions Int @default(0)
  totalSessions    Int @default(0)
  painLevel Float?
  sleepQuality Float?
  week      DateTime @default(now())
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model Reminder {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      ReminderType @default(SESSION)
  time      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

enum ReminderType {
  SESSION
  EXERCISE
  MEDICATION
}